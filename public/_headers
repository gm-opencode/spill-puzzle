# Cache rules for Cloudflare Pages and Netlify (both read this file).
# The service worker and the HTML must always be revalidated so updates are found;
# hashed build assets can be cached forever.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
